{
  "name": "@progbox/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.engine.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude \"**/*.engine.test.ts\"",
    "test:engine": "vitest run src/engine.smoke.engine.test.ts",
    "build:engine": "node scripts/build-engine.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.5",
    "form-data": "^4.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
