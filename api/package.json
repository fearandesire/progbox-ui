{
  "name": "@progbox/api",
  "private": true,
  "scripts": {
    "dev": "python devserver.py",
    "build:engine": "bash vendor/progbox_cpp/buildprogbox.sh",
    "lint": "python -m compileall -q .",
    "test": "pytest -m \"not engine\"",
    "test:coverage": "pytest --cov=main --cov=routes --cov=services --cov-report=term-missing --cov-fail-under=70 -m \"not engine\"",
    "test:engine": "pytest -m engine"
  }
}
