{
  "name": "progbox-ui",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web-only": "pnpm --filter web dev",
    "dev:api-only": "pnpm --filter @progbox/api dev",
    "setup": "pnpm run setup:wsl",
    "build": "pnpm --filter web build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run lint:api",
    "check:fix": "pnpm --filter web lint:fix",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "lint:api": "pnpm --filter @progbox/api lint",
    "build:engine": "pnpm --filter @progbox/api build:engine",
    "doctor": "node scripts/doctor.mjs",
    "setup:wsl": "bash scripts/setup-wsl.sh",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "test": "pnpm run test:web && pnpm run test:api",
    "test:web": "pnpm --filter web test",
    "test:api": "pnpm --filter @progbox/api test",
    "test:api:engine": "pnpm --filter @progbox/api test:engine",
    "test:e2e": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "verify": "pnpm run check && pnpm run test && pnpm run test:api:engine && pnpm run test:e2e",
    "verify:full": "pnpm run check && pnpm run test && pnpm run test:api:engine && pnpm run test:e2e:full"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
